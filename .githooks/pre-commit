#!/bin/sh
# Commit-level quality gate (`run.py commit`: ruff on the staged .py files, the determinism scan, the assertion check
# on the staged test files, and pytest on the related test files only — within about 10 seconds). The full level
# (`run.py l0`: whole-tree ruff + mypy + the whole pytest suite) runs once at the end of the task, before merge, not
# here. Runs when the commit stages a Python file or any other path the checks read. Enable once per clone/machine:
#   git config core.hooksPath .githooks
# (core.hooksPath is local, per-clone config — it does NOT travel with the repo, so a fresh
# clone or a new machine has this hook silently absent until the command above is run again.)
#
# Uses `if ! cmd; then ... fi`, NOT `cmd; if [ $? -ne 0 ]` — under `set -e`, a plain failing
# command aborts the script immediately and the `if [ $? -ne 0 ]` check below it never runs
# (silently skipping the gate). `if ! cmd; then` evaluates `cmd`'s exit status as part of the
# conditional itself, so `set -e` does not fire on it.
set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# G3(c) (determinism) also scans pyproject.toml / pytest.ini (pytest config) and requirements*.txt (dependency pins),
# and guards every file under a quality-gates/ folder (checkers, their canaries) and this hook itself.
staged_py=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py' 'pyproject.toml' 'pytest.ini' '*requirements*.txt' '*quality-gates/*' 'quality-gates/determinism-canaries' '.githooks/pre-commit')

if [ -n "$staged_py" ]; then
  checked_count=$(printf '%s\n' "$staged_py" | grep -c .)
  echo "[pre-commit] $checked_count staged file(s) — running quality-gates commit (staged-file lint, determinism, assertions, related tests)..."
  if ! py -3.11 quality-gates/run.py commit; then
    echo "[pre-commit] checked: $checked_count staged file(s) | skipped: 0 (commit gate) — FAILED, commit blocked."
    echo "[pre-commit] fix the above and retry, or --no-verify to bypass (discouraged, logged as a rule violation)."
    exit 1
  fi
  echo "[pre-commit] checked: $checked_count staged file(s) | skipped: 0 (commit gate) — PASSED."
else
  echo "[pre-commit] checked: 0 staged file(s) | skipped: commit gate (no checked file staged)."
fi

exit 0
